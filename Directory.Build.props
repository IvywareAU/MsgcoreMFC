<Project>
  <!--
    Repo-root MSBuild properties for the MsgcoreMFC repository.

    This file exists so that a clone of THIS repository alone builds correctly. Before it,
    $(WDMSCS_LIB) was defaulted only by MSCS\Directory.Build.props in the surrounding tree,
    which is not part of this repository: a standalone clone got neither the default nor the
    guard in Directory.Build.targets, and link.exe wrote the import library and its .exp to
    the ROOT OF THE CURRENT DRIVE, silently, with the build still green. (Historic evidence
    from exactly that failure: C:\MsgcoreMFC(2026)d.lib and three siblings, Apr/May 2026,
    under the pre-d50f150 artifact names.)

    MSBuild imports only the NEAREST Directory.Build.props walking up from the project, so
    this file shadows the outer one for MsgcoreMFC(2026).vcxproj. That would silently move
    the staging directory for anyone building inside the MSCS tree, where sibling projects
    (TargetCore, TargetCoreMFC) link against MSCS\lib\... — so if an outer
    Directory.Build.props exists, chain to it and let it win. The standalone defaults below
    apply only when there is no outer file, i.e. in a real standalone clone.

    Modelled on Msgcore\Directory.Build.props, with ONE deliberate difference: the standalone
    default is the PARENT directory's lib\, not this repository's own. Msgcore links no
    sibling and can stage into itself; this project links Msgcore.lib, and TargetCoreMFC
    links three siblings, so they must all resolve to ONE directory. The published
    build-from-source route clones the four repositories side by side, which makes the shared
    parent the only place they can agree on without an environment variable. Setting
    WDMSCS_LIB explicitly is still the recommended way, and still wins.
  -->

  <PropertyGroup>
    <MsgcoreMFCOuterBuildProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</MsgcoreMFCOuterBuildProps>
  </PropertyGroup>

  <Import Project="$(MsgcoreMFCOuterBuildProps)"
          Condition="'$(MsgcoreMFCOuterBuildProps)' != '' and Exists('$(MsgcoreMFCOuterBuildProps)')" />

  <PropertyGroup>
    <MsgcoreMFCStandalone Condition="'$(MsgcoreMFCOuterBuildProps)' == ''">true</MsgcoreMFCStandalone>
  </PropertyGroup>

  <!-- Standalone clone: default WDMSCS_LIB to the lib\ beside this repository, so the
       variable is never empty and never relative, and so a sibling clone of Msgcore stages
       its import library where this project will look for it. An explicit WDMSCS_LIB
       (environment or command line) still wins, exactly as in the outer file. -->
  <PropertyGroup Condition="'$(MsgcoreMFCStandalone)' == 'true' and '$(WDMSCS_LIB)' == ''">
    <WDMSCS_LIB>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\lib'))</WDMSCS_LIB>
  </PropertyGroup>

  <!-- Import libs are keyed by BOTH platform and configuration. Artifact names carry no
       version suffix and no debug 'd', so Debug and Release produce identically named
       .lib files; only the directory keeps them apart. Do not collapse this back to
       per-platform-only or Release will overwrite Debug. Mirrors the outer file. -->
  <PropertyGroup Condition="'$(MsgcoreMFCStandalone)' == 'true' and '$(WDMSCS_LIB)' != '' and '$(Platform)' != '' and '$(Configuration)' != ''">
    <WDMSCS_LIB_ROOT Condition="'$(WDMSCS_LIB_ROOT)' == ''">$(WDMSCS_LIB)</WDMSCS_LIB_ROOT>
    <WDMSCS_LIB>$(WDMSCS_LIB_ROOT)\$(Platform)\$(Configuration)</WDMSCS_LIB>
  </PropertyGroup>
</Project>
